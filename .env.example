# Copiar a .env.local (que está en .gitignore) y completar.
# Los mismos tres valores van en Vercel → Settings → Environment Variables.

# Supabase — proyecto "giuliett-patisserie" (región São Paulo).
# Dashboard → Project Settings → API Keys.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave PUBLICABLE (sb_publishable_...). La usan el panel y proxy.ts para la sesión.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Clave SECRETA (sb_secret_...). SOLO servidor: inserta las consultas y crea administradores.
# Nunca con prefijo NEXT_PUBLIC_. Nunca commitear. Nunca pegar en un chat.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Opcionales -------------------------------------------------------------

# URL pública del sitio (canonical, sitemap, tarjetas OG, enlaces de los emails).
# Si falta, se usa la URL de producción de Vercel. Poner el dominio SOLO cuando el DNS ya apunte.
# NEXT_PUBLIC_SITE_URL=https://giuliettpatisserie.com

# Aviso por email a Giu cuando entra una consulta (lib/notificaciones/consulta-nueva.ts).
# Sin estas dos variables no se manda nada y la consulta se guarda igual.
# El remitente tiene que ser de un dominio verificado en Resend (Fase E, con el DNS).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# AVISOS_EMAIL_DESTINO=giu@ejemplo.com, otro@ejemplo.com
# AVISOS_EMAIL_REMITENTE=Giuliett Web <avisos@giuliettpatisserie.com>
